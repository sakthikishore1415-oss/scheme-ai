{
  "name": "pacs-sahayak",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspace=@pacs-sahayak/web",
    "build": "turbo run build && node scripts/collect_build_artifacts.js",
    "build:web": "turbo run build --filter=@pacs-sahayak/web",
    "build:android": "turbo run build --filter=@pacs-sahayak/android",
    "build:ios": "turbo run build --filter=@pacs-sahayak/ios",
    "build:all": "turbo run build && node scripts/collect_build_artifacts.js",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "export:schemes": "python3 scripts/export_schemes.py",
    "fetch-schemes": "python3 scripts/fetch_all_india_schemes.py"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "lucide-react": "^0.546.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turbo": "^2.4.4",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
