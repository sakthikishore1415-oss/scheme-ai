{
  "name": "arivom-thittam",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web && mkdir -p dist && cp -r apps/web/dist/* dist/",
    "lint": "npm run lint --workspace=apps/web",
    "clean": "turbo run clean",
    "fetch-schemes": "python3 scripts/fetch_all_india_schemes.py"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
