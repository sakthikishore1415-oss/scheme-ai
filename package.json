{
  "name": "arivom-thittam",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @arivom-thittam/web dev",
    "build": "turbo run build && mkdir -p dist && cp -r apps/web/dist/* dist/",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "export:schemes": "python3 scripts/export_schemes.py",
    "fetch-schemes": "python3 scripts/fetch_all_india_schemes.py"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "lucide-react": "^0.546.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turbo": "^2.4.4",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
