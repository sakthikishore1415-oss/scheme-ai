{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@arivom-thittam/scheme-data#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@arivom-thittam/api-contracts#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@arivom-thittam/eligibility-spec#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
